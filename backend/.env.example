# Copy this file to .env (same folder) and fill in real values.
# .env is git-ignored. Never commit real passwords or secrets.

APP_NAME=TaskFlow API

# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://taskflow_user:change_me@localhost:5432/taskflow

# Separate database used only by pytest (all its tables are wiped during test runs).
# If omitted, tests use DATABASE_URL with the database name replaced by "taskflow_test".
TEST_DATABASE_URL=postgresql+psycopg://taskflow_user:change_me@localhost:5432/taskflow_test

# Secret used to sign JWTs (at least 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend origins allowed to call the API from a browser (JSON list).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Set to true to print every SQL statement SQLAlchemy sends (useful for learning/debugging).
SQL_ECHO=false
